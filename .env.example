# Provisional B from the measured 50-answer same-exam comparison; Max prepares rubrics.
# Select A/B/C per job without changing other batches. Secrets stay in the ignored file.
AI4EDU_CREDENTIALS_FILE=bailian.txt
# Explicit environment credentials override file values; leave these unset to use the file.
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI4EDU_MODEL=qwen3.7-plus
# Optional role-specific model IDs; empty means use the explicitly configured AI4EDU_MODEL.
AI4EDU_LAYOUT_MODEL=
AI4EDU_RUBRIC_MODEL=qwen3.8-max
AI4EDU_TRANSCRIBE_MODEL=qwen3.7-plus
AI4EDU_GRADE_MODEL=qwen3.7-plus
AI4EDU_VERIFY_MODEL=qwen3.8-max
# JSON mapping: {"your-model-id":{"input":2,"output":8}}. CNY per million tokens.
AI4EDU_MODEL_PRICES={"qwen3.7-plus":{"input":2,"output":8},"qwen3.8-max":{"input":12,"output":36}}
AI4EDU_MAX_OUTPUT_TOKENS=4096
AI4EDU_MAX_TRANSCRIPTION_TOKENS=8192
AI4EDU_MAX_GRADING_TOKENS=4096
AI4EDU_MAX_INPUT_TOKENS=250000
AI4EDU_TRANSCRIPTION_IMAGES_PER_CALL=1
AI4EDU_TRANSCRIPTION_CONCURRENCY=2
AI4EDU_THINKING_ROLES=[]
AI4EDU_THINKING_BUDGET=1024
AI4EDU_HTTP_TIMEOUT=240
AI4EDU_MAX_PIXELS=2621440
AI4EDU_REGION_PADDING_RATIO=0.04
AI4EDU_MODEL_CONCURRENCY=16
AI4EDU_MODEL_RPM=120
AI4EDU_MODEL_TPM=500000
AI4EDU_TASK_LEASE_SECONDS=300
AI4EDU_VERIFICATION_POLICY=off
AI4EDU_AUDIT_RATE=0.1
# Set a nonempty bearer token when exposing the API outside a trusted development network.
AI4EDU_SERVICE_API_KEY=
AI4EDU_DATABASE_URL=postgresql+psycopg://ai4edu:ai4edu@localhost:5432/ai4edu
AI4EDU_REDIS_URL=redis://localhost:6379/0
AI4EDU_STORAGE_BACKEND=local
AI4EDU_STORAGE_DIR=data/assets
AI4EDU_OSS_ENDPOINT=
AI4EDU_OSS_BUCKET=
AI4EDU_OSS_ACCESS_KEY_ID=
AI4EDU_OSS_ACCESS_KEY_SECRET=
